{
  "name": "my-tg-agent",
  "version": "1.0.0",
  "description": "",
  "main": "packages/bot/src/index.ts",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=development bun run packages/bot/src/index.ts",
    "start": "NODE_ENV=production bun run packages/bot/src/index.ts",
    "prepare": "husky install",
    "clean": "rm -rf node_modules packages/*/node_modules bun.lock",
    "re-install": "bun run clean && bun install",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.ts\"",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/adk-devtools": "^0.3.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^20.19.39",
    "dotenv": "^17.4.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@langchain/google": "^0.1.10",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "longbridge": "4.0.5",
    "ollama": "^0.6.3",
    "zod": "^4.3.6"
  }
}
